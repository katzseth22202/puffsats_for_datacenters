  urldate      = {2026-09-19},
  note         = {Published 15 October 2025. States that Starcloud plans a 5-gigawatt orbital data center with solar and cooling panels approximately 4 kilometers in width and length. The 60 kg Starcloud-1 demonstrator carried the first NVIDIA H100 to orbit. Accessed: 2026-09-19}
