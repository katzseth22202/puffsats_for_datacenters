% Orbital data-center proposals, cited in the Introduction. Project Suncatcher
% carries the market and the need for short, high-bandwidth links within each
% cluster. The Starcloud entries carry the scale (5 GW, 88,000 satellites) and
% the $500/kg launch price at which its chief executive says orbital computing
% competes with terrestrial data centers. All copied unchanged from
% katzseth22202/Balloon-Pulse-Propulsion.

@misc{aguera2026_suncatcher,
  author       = {Ag\"uera y Arcas, Blaise and Beals, Travis and Biggs, Maria and Bloom, Jessica V. and Fischbacher, Thomas and Gromov, Konstantin and K\"oster, Urs and Pravahan, Rishiraj and Manyika, James},
  title        = {Towards a Future Space-Based, Highly Scalable {AI} Infrastructure System Design},
  year         = {2026},
  eprint       = {2511.19468},
  archiveprefix = {arXiv},
  doi          = {10.48550/arXiv.2511.19468},
  url          = {https://arxiv.org/html/2511.19468v2},
  note         = {Version 2, June 17, 2026. Project Suncatcher proposes dawn--dusk sun-synchronous orbital computing with high-bandwidth, low-latency links within the cluster. Sections 2.4 and 4.4 independently model planned Starship 4 launch economics using public specifications and reuse assumptions. Ten uses per component yield internal costs of at most about \$60/kg and a customer price below \$250/kg at an assumed 75\% margin. These are future-vehicle projections, not an early operational launch quote. The same sections find that at \$200/kg, ``the cost of launch amortized over spacecraft lifetime could be roughly comparable to data center energy costs, on a per-kW basis.'' For a Starlink v2 mini-class satellite (575~kg, about 28~kW, five-year life) that is about \$810/kW/yr against terrestrial power spending of \$570--\$3000/kW/yr. The parity covers energy only and excludes buildings, infrastructure and chips. Accessed: 2026-09-13}
}

