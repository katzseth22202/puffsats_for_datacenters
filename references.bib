@misc{foust2026_starcloud_fcc,
  author       = {Foust, Jeff},
  title        = {Starcloud Files Plans for 88,000-Satellite Constellation},
  howpublished = {\url{https://spacenews.com/starcloud-files-plans-for-88000-satellite-constellation/}},
  year         = {2026},
  month        = mar,
  urldate      = {2026-09-19},
  note         = {SpaceNews, 15 March 2026. The FCC accepted the filing on 13 March 2026. Starcloud proposes up to 88,000 satellites in a select set of narrow orbital shells up to 50 km thick, between 600 km and 850 km, in dawn--dusk sun-synchronous orbits at a nominal 06:00 crossing time for near-continuous power generation. Accessed: 2026-09-19}
}

@misc{bennici2026_johnston,
  author       = {Bennici, Luca and Johnston, Philip},
  title        = {The Case for Data Centers in Space},
  howpublished = {\url{https://www.mckinsey.com/industries/technology-media-and-telecommunications/our-insights/the-case-for-data-centers-in-space}},
  year         = {2026},
  month        = may,
  note         = {McKinsey \& Company interview, 8 May 2026, of Starcloud CEO Philip Johnston by McKinsey partner Luca Bennici. Johnston: ``If launch costs decline materially, potentially to around \$500 per kilogram, space-based compute becomes economically competitive with terrestrial alternatives.'' Also gives infrastructure costs ``under \$5 million per megawatt, versus \$12 million to \$15 million for terrestrial systems'' and describes Starcloud 3 as ``an approximately 200-kW system, about three tons.'' McKinsey states that interviewees' opinions are their own. Accessed: 2026-09-21}
}
