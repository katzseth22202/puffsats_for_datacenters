@book{wright2005_physics_space_security,
  author       = {Wright, David and Grego, Laura and Gronlund, Lisbeth},
  title        = {The Physics of Space Security: A Reference Manual},
  publisher    = {American Academy of Arts and Sciences},
  address      = {Cambridge, Massachusetts},
  year         = {2005},
  howpublished = {\url{https://www.amacad.org/publication/physics-space-security-reference-manual}},
  urldate      = {2026-09-19},
  note         = {Prepared for the American Academy's Reconsidering the Rules of Space project. Section 11 covers direct-ascent kinetic attacks: a homing interceptor's attacker ``need not determine the trajectory of the satellite with high accuracy,'' only well enough for the onboard sensor to acquire, and ``simple homing systems using commercially available sensors should be within the reach of many other countries.'' Satellites in sunlight ``would reflect sunlight and would have a relatively high surface temperature, both of which could be used for homing.'' Section 12 and its appendix model a simple ground-based pellet (non-homing) ASAT carrying 500 kg of pellets to 600 km on a Nodong-class missile, and conclude that in its simplest form such a weapon ``may have limited effectiveness,'' limited by orbit-determination accuracy and by missile CEP. Altitude uncertainties of a few km out of a 7000 km orbital radius ``are enough to significantly reduce the effectiveness of an ASAT.'' Shielding sets a pellet floor near 1 g and 1 cm. The section also notes that the area which must be hit to disable a satellite ``may be much smaller than its total area,'' since solar panels can absorb a number of hits, and that a space-based ASAT ``could be designed to limit its optical and radar signatures.'' Accessed: 2026-09-19}
}

