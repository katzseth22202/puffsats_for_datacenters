@misc{aguera2026_suncatcher,
  author       = {Ag\"uera y Arcas, Blaise and Beals, Travis and Biggs, Maria and Bloom, Jessica V. and Fischbacher, Thomas and Gromov, Konstantin and K\"oster, Urs and Pravahan, Rishiraj and Manyika, James},
  title        = {Towards a Future Space-Based, Highly Scalable {AI} Infrastructure System Design},
  year         = {2026},
  eprint       = {2511.19468},
  archiveprefix = {arXiv},
  doi          = {10.48550/arXiv.2511.19468},
  url          = {https://arxiv.org/html/2511.19468v2},
  note         = {Version 2, June 17, 2026. Project Suncatcher proposes dawn--dusk sun-synchronous orbital computing with high-bandwidth, low-latency links within the cluster. Sections 2.4 and 4.4 independently model planned Starship 4 launch economics using public specifications and reuse assumptions. Ten uses per component yield internal costs of at most about \$60/kg and a customer price below \$250/kg at an assumed 75\% margin. These are future-vehicle projections, not an early operational launch quote. The same sections find that at \$200/kg, ``the cost of launch amortized over spacecraft lifetime could be roughly comparable to data center energy costs, on a per-kW basis.'' For a Starlink v2 mini-class satellite (575~kg, about 28~kW, five-year life) that is about \$810/kW/yr against terrestrial power spending of \$570--\$3000/kW/yr. The parity covers energy only and excludes buildings, infrastructure and chips. Section 2.2 lays out an illustrative planar 81-satellite cluster at a mean altitude of 650 km: ``Cluster radius is R=1 km, with distance between next-nearest-neighbor satellites oscillating between (approximately) 100 and 200 m.'' The authors add that ``evolving constraints could change the optimal architecture.'' Accessed: 2026-09-25}
}

